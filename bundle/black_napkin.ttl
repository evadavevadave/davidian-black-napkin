@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix pprop: <http://lv2plug.in/ns/ext/port-props#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .

<urn:davidian:black-napkin>
	a lv2:Plugin , lv2:FilterPlugin ;
	doap:name "Davidian Black Napkin" ;
	doap:license <http://opensource.org/licenses/GPL-3.0> ;
	rdfs:comment "Circuit model of a 1970s-style voltage-controlled filter pedal: a resonant two-OTA state-variable band-pass swept by an envelope follower (attack, decay, range, up or down) or by a clocked sample and hold of transistor noise. GPL-3.0-or-later. Made with generative AI (Claude Code); see AI_USAGE.md in the bundle." ;
	lv2:minorVersion 0 ;
	lv2:microVersion 0 ;
	lv2:optionalFeature lv2:hardRTCapable ;
	lv2:port [
		a lv2:AudioPort , lv2:InputPort ;
		lv2:index 0 ;
		lv2:symbol "in" ;
		lv2:name "In"
	] , [
		a lv2:AudioPort , lv2:OutputPort ;
		lv2:index 1 ;
		lv2:symbol "out" ;
		lv2:name "Out"
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 2 ;
		lv2:symbol "range" ;
		lv2:name "Range" ;
		lv2:default 0.6 ;
		lv2:minimum 0.0 ;
		lv2:maximum 1.0
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 3 ;
		lv2:symbol "resonance" ;
		lv2:name "Resonance" ;
		lv2:default 0.4 ;
		lv2:minimum 0.0 ;
		lv2:maximum 1.0
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 4 ;
		lv2:symbol "attack" ;
		lv2:name "Attack" ;
		lv2:default 0.2 ;
		lv2:minimum 0.0 ;
		lv2:maximum 1.0
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 5 ;
		lv2:symbol "decay" ;
		lv2:name "Decay" ;
		lv2:default 0.3 ;
		lv2:minimum 0.0 ;
		lv2:maximum 1.0
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 6 ;
		lv2:symbol "speed" ;
		lv2:name "S/H Speed" ;
		lv2:default 0.5 ;
		lv2:minimum 0.0 ;
		lv2:maximum 1.0
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 7 ;
		lv2:symbol "direction" ;
		lv2:name "Sweep Direction" ;
		lv2:default 0 ;
		lv2:minimum 0 ;
		lv2:maximum 1 ;
		lv2:portProperty lv2:toggled , lv2:integer ;
		lv2:scalePoint [ rdfs:label "Up" ; rdf:value 0 ] , [ rdfs:label "Down" ; rdf:value 1 ]
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 8 ;
		lv2:symbol "mode" ;
		lv2:name "Mode" ;
		lv2:default 0 ;
		lv2:minimum 0 ;
		lv2:maximum 1 ;
		lv2:portProperty lv2:toggled , lv2:integer ;
		lv2:scalePoint [ rdfs:label "Envelope" ; rdf:value 0 ] , [ rdfs:label "Sample and Hold" ; rdf:value 1 ]
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 9 ;
		lv2:symbol "sh_depth" ;
		lv2:name "S/H Depth (internal trim)" ;
		lv2:default 0.7 ;
		lv2:minimum 0.0 ;
		lv2:maximum 1.0
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 10 ;
		lv2:symbol "sh_offset" ;
		lv2:name "S/H Centre (internal trim)" ;
		lv2:default 0.6 ;
		lv2:minimum 0.0 ;
		lv2:maximum 1.0
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 11 ;
		lv2:symbol "volts" ;
		lv2:name "Volts at 0 dBFS" ;
		lv2:default 1.0 ;
		lv2:minimum 0.1 ;
		lv2:maximum 10.0 ;
		lv2:portProperty pprop:logarithmic
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 12 ;
		lv2:symbol "output" ;
		lv2:name "Output" ;
		lv2:default 0.0 ;
		lv2:minimum -24.0 ;
		lv2:maximum 12.0 ;
		units:unit units:db
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 13 ;
		lv2:symbol "enabled" ;
		lv2:name "Enabled" ;
		lv2:default 1 ;
		lv2:minimum 0 ;
		lv2:maximum 1 ;
		lv2:designation lv2:enabled ;
		lv2:portProperty lv2:toggled
	] , [
		a lv2:ControlPort , lv2:OutputPort ;
		lv2:index 14 ;
		lv2:symbol "latency" ;
		lv2:name "Latency" ;
		lv2:minimum 0 ;
		lv2:maximum 32 ;
		lv2:designation lv2:latency ;
		lv2:portProperty lv2:reportsLatency , lv2:integer ;
		units:unit units:frame
	] .
